# Используем легковесный образ с Java 17
FROM eclipse-temurin:17-jre-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем собранный jar-файл из target в контейнер
# (Имя файла может немного отличаться, проверь папку target своего модуля!)
COPY target/*.jar app.jar

# Открываем порт (по умолчанию для всех наших сервисов, кроме gateway, но это не мешает)
EXPOSE 8080

# Команда запуска
ENTRYPOINT ["java", "-jar", "app.jar"]